# Required: use at least 12 characters; never commit your real .env.
APP_PASSWORD=replace-with-a-long-unique-password
LLM_PROVIDER=agent_router
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol
LLM_BASE_URL=https://agentrouter.org/v1
# For OpenRouter: LLM_PROVIDER=openrouter, LLM_BASE_URL=https://openrouter.ai/api/v1
# For Gemini: LLM_PROVIDER=google, LLM_MODEL=<available Gemini model>, omit LLM_BASE_URL
DATA_DIR=/data
MAX_STEPS=100
TASK_TIMEOUT_SECONDS=3600
SERVICE_MEMORY_LIMIT=2g
USE_VISION=true
CHROMIUM_SANDBOX=false
# Container isolation is required when the Chromium user-namespace sandbox is unavailable.

# Verified Agent Router transport (official Codex CLI + Responses API)
AGENT_ROUTER_TRANSPORT=codex
MODEL_TIMEOUT_SECONDS=120
# Browser-use exposes multi-action steps; bounded to 1..3 by this app.
AGENT_MAX_ACTIONS=2
